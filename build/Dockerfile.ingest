# syntax=docker/dockerfile:1
# Ingest job: static Go binary plus the default sources config.
ARG GO_IMAGE=cgr.dev/chainguard/go:latest-dev
ARG RUNTIME_IMAGE=cgr.dev/chainguard/static:latest

FROM ${GO_IMAGE} AS build
WORKDIR /src
ARG GOPROXY
ARG GONOSUMDB
ARG GOFLAGS
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/ingest ./cmd/ingest

FROM ${RUNTIME_IMAGE}
COPY --from=build /out/ingest /usr/bin/ingest
COPY configs/sources.yaml /etc/vulnviz/sources.yaml
ENV VULNVIZ_CONFIG=/etc/vulnviz/sources.yaml VULNVIZ_TEMP=/scratch
USER 65532:65532
ENTRYPOINT ["/usr/bin/ingest"]
CMD ["all"]
