# syntax=docker/dockerfile:1
# Web frontend: Vite build served by nginx, which also proxies /api to the API service.
ARG NODE_IMAGE=cgr.dev/chainguard/node:latest-dev
ARG NGINX_IMAGE=cgr.dev/chainguard/nginx:latest

FROM ${NODE_IMAGE} AS build
WORKDIR /app
ARG NPM_CONFIG_REGISTRY
COPY --chown=node:node web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --chown=node:node web/ ./
RUN npm run build

FROM ${NGINX_IMAGE}
COPY build/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
